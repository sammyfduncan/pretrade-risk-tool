# Copy to .env (gitignored) and fill in.
#
# IG credentials — used for epic lookup, recent price checks, and (later) paper
# execution. NOT needed to download training data: that comes from Dukascopy,
# which requires no account.
#
# Get an API key: log in to IG's web platform -> My Account -> Settings ->
# API keys -> generate. Create it on a DEMO account while developing.
# Note the key is tied to the account it was generated on, and IG_ACC_TYPE
# must match (demo key -> demo, live key -> live).
IG_API_KEY=your-api-key-here
IG_USERNAME=your-ig-username
IG_PASSWORD=your-ig-password
IG_ACC_TYPE=demo
# Optional — only needed if your login has several accounts and you want a
# specific one (e.g. Z7ABCD).
IG_ACC_NUMBER=
